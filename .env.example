# ============================================================
# Cronos Chain Sniper Bot configuration
# Copy to .env and fill in. NEVER commit your real .env.
# Start with MODE=paper, then MODE=testnet, only then live.
# Fork of LaChance-Lab robinhood-sniper-bot, retargeted to Cronos.
# ============================================================

# --- Chain (Cronos EVM) ------------------------------------
# Mainnet: chain id 25,  https://evm.cronos.com/
# Testnet: chain id 338, https://evm-t3.cronos.com/
CRONOS_RPC_URL=https://evm.cronos.com/
# Optional WebSocket endpoint (falls back to HTTP polling if unset)
CRONOS_WS_URL=
CHAIN_ID=25

# Legacy aliases still work: ROBINHOOD_RPC_URL / ROBINHOOD_WS_URL

# --- Wallet ------------------------------------------------
PRIVATE_KEY=
WALLET_ADDRESS=

# --- Mode --------------------------------------------------
# paper   = no chain writes, simulated fills (works with DEX_TYPE=mock)
# testnet = real transactions on Cronos testnet (338)
# live    = real money. Requires ENABLE_LIVE_TRADING=true AND `bot confirm-live`.
MODE=paper

# --- DEX (VVS Finance on Cronos = Uniswap V2–compatible) ---
# For paper practice leave mock; for watch/live on Cronos use uniswap_v2 + VVS:
DEX_TYPE=mock
# VVS Factory (verify on https://explorer.cronos.com before live):
DEX_FACTORY_ADDRESS=0x3b44b2a187a7b3824131f8db5a74194d0a42fc15
# VVS Router:
DEX_ROUTER_ADDRESS=0x145863Eb42Cf62847A6Ca784e6416C1682b1b2Ae
# Uniswap v3 only: QuoterV2 (leave blank for VVS)
DEX_QUOTER_ADDRESS=
# WCRO (wrapped CRO) — base/quote for most Cronos pairs:
BASE_TOKEN_ADDRESS=0x5C7F8A570d578ED84E63fdFA7b1eE72dEae1AE23
BASE_TOKEN_IS_NATIVE_WRAPPER=true

# --- Cronos Launch birth sniping -------------------------
# Official pad: https://launch.cronos.com/
# Watches Launched on the launch entry, buys via payable entry.buy (CRO).
# After graduation use DEX_TYPE=uniswap_v2 (VVS) instead.
# DEX_TYPE=cronos_launch
# Launch factory (AMM):
# DEX_FACTORY_ADDRESS=0x227205a020bd5522e45436176d85603d2dcc43c5
# Launch entry (create + curve buy/sell) — set as DEX_ROUTER_ADDRESS for this adapter:
# DEX_ROUTER_ADDRESS=0xa18f14a35853bc619132ba9e126bf2ec63183c8e
# WCRO:
# BASE_TOKEN_ADDRESS=0x5C7F8A570d578ED84E63fdFA7b1eE72dEae1AE23
# BASE_TOKEN_IS_NATIVE_WRAPPER=true
# See docs/CRONOS_LAUNCH.md

# --- Risk limits -------------------------------------------
# Buy size in native units (CRO on Cronos; field name is still MAX_BUY_ETH)
MAX_BUY_ETH=0.01
MAX_SLIPPAGE_BPS=300
# Cronos gas is often thousands of gwei — do not leave this at 5
MAX_GAS_GWEI=10000
MIN_LIQUIDITY_ETH=1
MAX_TOKEN_TAX_BPS=1000
TAKE_PROFIT_PERCENT=50
STOP_LOSS_PERCENT=20
TRAILING_STOP_PERCENT=
MAX_OPEN_POSITIONS=3
COOLDOWN_SECONDS=60

# --- Live-trading master switch ----------------------------
ENABLE_LIVE_TRADING=false

# --- Misc --------------------------------------------------
DB_PATH=./data/bot.db
LOG_LEVEL=info
PAPER_BALANCE_ETH=10
POSITION_POLL_MS=5000
